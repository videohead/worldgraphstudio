# Copy this file to .env and change local credentials before first use.
WORDPRESS_PORT=8080
PHPMYADMIN_PORT=8081
HEADLESS_PORT=3000

WORDPRESS_DB_NAME=wordpress
WORDPRESS_DB_USER=wordpress
WORDPRESS_DB_PASSWORD=wordpress
WORDPRESS_DB_ROOT_PASSWORD=wordpress
WORDPRESS_TABLE_PREFIX=wp_

WORDPRESS_WEBHOOK_SECRET=change-me
WORLDGRAPH_ADMIN_USER=
WORLDGRAPH_ADMIN_APP_PASSWORD=

# Bearer token comfy-api-proxy requires on /comfy/api/v2 (local ComfyUI
# execution). Must match COMFY_API_PROXY_TOKEN in /opt/ComfyUI/.env.
WORLDGRAPH_COMFY_API_KEY=
# Comfy Cloud API key for hosted Comfy API v2 execution.
COMFY_CLOUD_API_KEY=
WORLDGRAPH_AI_API_KEY=
WORLDGRAPH_AI_FALLBACK_API_KEY=
WORLDGRAPH_AI_IMAGE_API_KEY=


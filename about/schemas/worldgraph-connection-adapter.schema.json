{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://worldgraph.studio/schemas/worldgraph-connection-adapter/1.1.0",
  "title": "World Graph Studio Connection adapter manifest",
  "description": "Strict portable authoring profile for entries returned through worldgraph_conn_adapters. It intentionally requires explicit labels and normalized object shapes even where the PHP runtime accepts older compatibility forms. Runtime closures must be represented by a function/class string or a [class, method] array before validation.",
  "x-worldgraph-schema-version": "1.1.0",
  "type": "object",
  "propertyNames": {
    "pattern": "^[a-z][a-z0-9_-]*$"
  },
  "additionalProperties": {
    "$ref": "#/$defs/adapter"
  },
  "$defs": {
    "callable": {
      "description": "A portable PHP callable: function/class string or [class, method]. Closures are valid only in the runtime PHP manifest and cannot be serialized here.",
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "array",
          "prefixItems": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "string",
              "minLength": 1
            }
          ],
          "minItems": 2,
          "maxItems": 2
        }
      ]
    },
    "setupOption": {
      "type": "object",
      "required": [
        "label",
        "environment"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "environment": {
          "enum": [
            "local",
            "development",
            "staging",
            "production"
          ]
        },
        "mcp_endpoint": {
          "type": "boolean",
          "default": false
        },
        "separate_mcp_credential": {
          "type": "boolean",
          "default": false
        }
      },
      "patternProperties": {
        "^x-": true
      },
      "additionalProperties": false
    },
    "callbacks": {
      "type": "object",
      "properties": {
        "test": {
          "description": "Callable (int connection_id, array record): array|WP_Error. The record is Connection_Repository::get() output, not the decoded resolve() shape. The returned array contains success, message, and health; core persists the normalized result. Core rejects health tests while the Connection is disabled and does not invoke this callback.",
          "$ref": "#/$defs/callable"
        },
        "after_save": {
          "description": "Optional synchronous callable (int connection_id, array record): void. Keep it lightweight and schedule slow work.",
          "$ref": "#/$defs/callable"
        },
        "render_admin": {
          "description": "Optional trusted wp-admin callable (WP_Post connection_post, array adapter): void. It must escape output and protect mutations with capabilities and nonces.",
          "$ref": "#/$defs/callable"
        }
      },
      "patternProperties": {
        "^x-": true
      },
      "additionalProperties": false
    },
    "oauthStaticParameters": {
      "description": "Trusted bounded scalar parameters added by the adapter. Protocol-owned parameters are always supplied by core and take precedence.",
      "type": "object",
      "maxProperties": 30,
      "propertyNames": {
        "pattern": "^[A-Za-z][A-Za-z0-9._~-]{0,99}$"
      },
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string",
            "maxLength": 2000
          },
          {
            "type": "number"
          },
          {
            "type": "boolean"
          }
        ]
      }
    },
    "oauthProfile": {
      "type": "object",
      "required": [
        "credential_field",
        "authorization_endpoint",
        "token_endpoint",
        "scopes"
      ],
      "properties": {
        "service_label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "credential_field": {
          "enum": [
            "credential_reference",
            "mcp_credential_reference"
          ]
        },
        "authorization_endpoint": {
          "type": "string",
          "format": "uri",
          "maxLength": 2048,
          "pattern": "^https://[^/?#@]+(?:/[^?#]*)?$"
        },
        "token_endpoint": {
          "type": "string",
          "format": "uri",
          "maxLength": 2048,
          "pattern": "^https://[^/?#@]+(?:/[^?#]*)?$"
        },
        "registration_endpoint": {
          "type": "string",
          "format": "uri",
          "maxLength": 2048,
          "pattern": "^https://[^/?#@]+(?:/[^?#]*)?$"
        },
        "resource": {
          "type": "string",
          "format": "uri",
          "maxLength": 2048,
          "pattern": "^https://[^/?#@]+(?:/[^?#]*)?$"
        },
        "scopes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 30,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 200,
            "pattern": "^[A-Za-z0-9._~:/-]+$"
          }
        },
        "token_endpoint_auth_method": {
          "const": "none"
        },
        "client_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^[^\\u0000-\\u0020\\u007F]+$"
        },
        "client_id_from_filter": {
          "const": true
        },
        "client_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "admin_intro": {
          "type": "string",
          "maxLength": 1000
        },
        "credential_help": {
          "type": "string",
          "maxLength": 1000
        },
        "usage_notice": {
          "type": "string",
          "maxLength": 1000
        },
        "connect_label": {
          "type": "string",
          "maxLength": 100
        },
        "disconnect_label": {
          "type": "string",
          "maxLength": 100
        },
        "authorization_parameters": {
          "$ref": "#/$defs/oauthStaticParameters"
        },
        "token_parameters": {
          "$ref": "#/$defs/oauthStaticParameters"
        },
        "registration_parameters": {
          "$ref": "#/$defs/oauthStaticParameters"
        }
      },
      "anyOf": [
        {
          "required": [
            "registration_endpoint"
          ]
        },
        {
          "required": [
            "client_id"
          ]
        },
        {
          "required": [
            "client_id_from_filter"
          ]
        }
      ],
      "patternProperties": {
        "^x-": true
      },
      "additionalProperties": false
    },
    "oauth": {
      "type": "object",
      "required": [
        "profiles"
      ],
      "properties": {
        "profiles": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_-]*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/oauthProfile"
          }
        }
      },
      "patternProperties": {
        "^x-": true
      },
      "additionalProperties": false
    },
    "templates": {
      "type": "object",
      "required": [
        "provision"
      ],
      "properties": {
        "provision": {
          "description": "Callable (int connection_id): array|WP_Error. It idempotently creates or updates provider Templates.",
          "$ref": "#/$defs/callable"
        },
        "delay": {
          "description": "Positive scheduling delay in seconds.",
          "type": "integer",
          "minimum": 1
        },
        "status_meta_prefix": {
          "description": "Stable non-secret prefix for Template_Manager-authoritative <prefix>_synced_at and <prefix>_error Connection metadata on the generic path. Successful provisioning stamps the sync time and clears a stale error unless the result contains a non-empty warning; scheduling or provisioning failure records the error without advancing the sync time. Bundled legacy direct entry points may mirror these keys for backward compatibility.",
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$"
        }
      },
      "patternProperties": {
        "^x-": true
      },
      "additionalProperties": false
    },
    "generation": {
      "type": "object",
      "properties": {
        "client": {
          "description": "Loaded class name implementing the static generation client signatures.",
          "type": "string",
          "minLength": 1
        },
        "client_resolver": {
          "description": "Callable (array connection, string provider_template_id, string adapter): string returning a trusted loaded client class.",
          "$ref": "#/$defs/callable"
        },
        "poll": {
          "description": "Whether a successful submission may require asynchronous polling.",
          "type": "boolean",
          "default": false
        },
        "poll_with_template": {
          "description": "Whether get_job_status receives provider_template_id as its third argument.",
          "type": "boolean",
          "default": false
        },
        "adapter": {
          "description": "Fixed sanitized adapter marker persisted with generation jobs. Callable values are not accepted; use adapter_resolver for dynamic selection.",
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "adapter_resolver": {
          "description": "Callable (array connection, string provider_template_id, string adapter): string selecting a sanitized marker from trusted saved state. Mutually exclusive with adapter.",
          "$ref": "#/$defs/callable"
        },
        "media_inputs": {
          "description": "Whether this adapter supports authorized resolved media inputs.",
          "type": "boolean",
          "default": false
        },
        "flatten_inputs": {
          "description": "Merge resolved media inputs into top-level parameters instead of parameters.inputs.",
          "type": "boolean",
          "default": false
        },
        "poll_error_limit": {
          "description": "Consecutive polling WP_Error results allowed before terminal failure.",
          "type": "integer",
          "minimum": 1
        },
        "permanent_error_codes": {
          "description": "Stable provider-prefixed WP_Error codes that make a polling error immediately terminal.",
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$"
          },
          "uniqueItems": true
        }
      },
      "oneOf": [
        {
          "required": [
            "client"
          ],
          "not": {
            "required": [
              "client_resolver"
            ]
          }
        },
        {
          "required": [
            "client_resolver"
          ],
          "not": {
            "required": [
              "client"
            ]
          }
        }
      ],
      "allOf": [
        {
          "not": {
            "required": [
              "adapter",
              "adapter_resolver"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "poll_with_template": {
                "const": true
              }
            },
            "required": [
              "poll_with_template"
            ]
          },
          "then": {
            "properties": {
              "poll": {
                "const": true
              }
            },
            "required": [
              "poll"
            ]
          }
        }
      ],
      "patternProperties": {
        "^x-": true
      },
      "additionalProperties": false
    },
    "adapter": {
      "type": "object",
      "required": [
        "label"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "icon": {
          "type": "string"
        },
        "endpoint": {
          "type": "string"
        },
        "mcp_endpoint": {
          "type": "string"
        },
        "files": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "loader": {
          "description": "Callable (string provider_type, array adapter): void. External plugins use it to load their own implementation files.",
          "$ref": "#/$defs/callable"
        },
        "init": {
          "description": "Optional callable (): void invoked once after the adapter implementation loads.",
          "$ref": "#/$defs/callable"
        },
        "setup_options": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_-]*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/setupOption"
          }
        },
        "show_in_plugins": {
          "type": "boolean",
          "default": true
        },
        "callbacks": {
          "$ref": "#/$defs/callbacks"
        },
        "oauth": {
          "$ref": "#/$defs/oauth"
        },
        "templates": {
          "$ref": "#/$defs/templates"
        },
        "generation": {
          "$ref": "#/$defs/generation"
        }
      },
      "patternProperties": {
        "^x-": true
      },
      "additionalProperties": false
    }
  }
}

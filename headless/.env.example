# WordPress connection (required)
WORDPRESS_URL="http://localhost:8080"
WORDPRESS_HOSTNAME="localhost"

# Secret shared with the WordPress "headless-revalidate" plugin.
# Generate with: openssl rand -base64 32
WORDPRESS_WEBHOOK_SECRET="change-me"

# Optional: credentials for headless admin actions against /wp-json/worldgraph/v1
# Create an Application Password for an administrator account in WordPress.
WORLDGRAPH_ADMIN_USER="admin"
WORLDGRAPH_ADMIN_APP_PASSWORD="xxxx xxxx xxxx xxxx xxxx xxxx"
